# Glint 的本地翻译模型：腾讯 HY-MT1.5-1.8B（Q4，1.1GB）。hy.gguf 和这个文件放同一目录，然后执行 ollama create hy-mt:1.8b -f hy-mt.Modelfile
FROM ./hy.gguf
TEMPLATE """<｜hy_begin▁of▁sentence｜>{{ range .Messages }}{{ if eq .Role "user" }}<｜hy_User｜>{{ .Content }}{{ else if eq .Role "assistant" }}<｜hy_Assistant｜>{{ .Content }}<｜hy_place▁holder▁no▁2｜>{{ end }}{{ end }}<｜hy_Assistant｜>"""
PARAMETER stop "<｜hy_place▁holder▁no▁2｜>"
PARAMETER stop "<｜hy_place▁holder▁no▁8｜>"
PARAMETER top_k 20
PARAMETER top_p 0.6
PARAMETER repeat_penalty 1.05
PARAMETER num_ctx 4096
